# =============================================================================
# Variáveis deste recurso (aba Environment Variables do Coolify)
# =============================================================================
# O recurso precisa de DUAS variáveis. Nenhum segredo é versionado.

# Chave especial do AppServer. Vai para o appserver.ini gerado no start.
# É um segredo de verdade: a porta 1234 fica publicada para o TDS.
# Gere uma aleatória:
#     openssl rand -hex 16
PROTHEUS_SPECIALKEY=

# Fuso horário dos containers do AppServer e do DbAccess (logs).
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# NÃO existe variável de senha de banco, e isso é deliberado.
#
# A imagem totvsengpro/postgres-dev:12.1.2510_bra traz o cluster JÁ
# INICIALIZADO, com os bancos postgres, protheus, template0 e template1 — e o
# `protheus` já criado em WIN1252 (encoding id 24 em pg_database). O
# superusuário é postgres/postgres, confirmado lendo o verificador
# SCRAM-SHA-256 em global/1260 (pg_authid) dentro da própria imagem.
#
# Por isso não há POSTGRES_PASSWORD/POSTGRES_DB: o docker-entrypoint encontra
# dados existentes e pula o initdb, então essas variáveis seriam inertes.
#
# A porta 5432 é interna ao recurso. Para endurecer: crie um usuário dedicado,
# troque -u/-p no seed-config e o USERNAME/PASSWORD da connection string.
# =============================================================================
