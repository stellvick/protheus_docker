{
	# Sem TLS aqui: quem termina o TLS e emite o certificado e o proxy do
	# Coolify, na frente. Este Caddy fala HTTP puro com o AppServer.
	auto_https off
	admin off
}

# Corpo comum, importado pelos dois blocos de porta abaixo.
(protheus_rest) {
	# Endpoint de healthcheck — o REST do Protheus responde 428 para tudo que
	# nao traz credencial, o que faria um healthcheck ingenuo reprovar um
	# servico que esta saudavel.
	handle /healthz {
		respond "ok" 200
	}

	# Passa o caminho INTACTO: o Protheus espera receber /REST/<metodo>.
	# Um handle_path (que remove o prefixo) quebraria a chamada.
	handle {
		reverse_proxy appserver:8081
	}
}

# Escuta em DUAS portas de proposito.
#
# O proxy do Coolify precisa saber em que porta alcancar este servico, e o
# criterio dele nao e obvio: para o dominio do appserver ele usa o
# ports_exposes do recurso (8080). Para este servico, que nao publica porta
# nenhuma, ele pode cair no padrao 80.
#
# Em vez de adivinhar, atendo nas duas — nao custa nada e elimina a duvida:
# um 502 aqui deixa de poder significar "porta errada".
:80 {
	import protheus_rest
}

:8080 {
	import protheus_rest
}
